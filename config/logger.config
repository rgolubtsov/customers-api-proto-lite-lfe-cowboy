%
% config/logger.config
% =============================================================================
% Customers API Lite microservice prototype (LFE/OTP port). Version 0.1.8
% =============================================================================
% A daemon written in LFE (Lisp Flavoured Erlang), designed and intended
% to be run as a microservice, implementing a special Customers API prototype
% with a smart yet simplified data scheme.
% =============================================================================
% (See the LICENSE file at the top of the source tree.)
%

[{kernel, [
    {logger, [
        {handler, default, logger_std_h,
            #{formatter => {logger_formatter, #{
                time_designator => $|,
                template        => ["[", time, "] [", level, "] ", msg, "\n"]
%                                         ^             ^           ^     ^
%                                         |             |           |     |
% --- Date and time ----------------------+             |           |     |
% --- Severity (info, debug, etc.) ---------------------+           |     |
% --- The logging message itself -----------------------------------+     |
% --- Newline character --------------------------------------------------+
            }}}
        },
        {handler, logfile, logger_std_h,
            #{formatter => {logger_formatter, #{
                time_designator => $|,
                template        => ["[", time, "] [", level, "] ", msg, "\n"]
            }},
            config => #{
                file               => "../../../../log/customers-api-lite.log",
                max_no_bytes       => 204800,
                max_no_files       => 10,
                compress_on_rotate => true,
                file_check         => 10000
            }}
        },
        {filters, log, [
            {supstart, {fun logger_filters:progress/2, stop}}
        ]}
    ]},
    {logger_level, debug}
]}].

% vim:set nu et ts=4 sw=4:
